NODE_ENV=development
PORT=4000
APP_URL=https://mbomsign.com

# Long random string (HTTP Basic password for /waitlist-admin)
SUBSCRIBERS_ADMIN_SECRET=
# WAITLIST_ADMIN_USER=admin

# SMTP (welcome emails) — Node-style names
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_ENCRYPTION=TLS
SMTP_FROM=MbomSign <noreply@mbomsign.com>

# Optional: true only if your provider needs strict STARTTLS
# SMTP_REQUIRE_TLS=true

# Optional: implicit TLS on non-standard ports (usually use port 465 instead)
# SMTP_SECURE=true
